# Basic App Settings
APP_ENV=prod
APP_DEBUG=1  # Enable temporarily for debugging

# Azure SQL Database Configuration (Doctrine DBAL format)
MAUTIC_DB_DRIVER=pdo_sqlsrv
MAUTIC_DB_HOST=sartorfit-db.database.windows.net
MAUTIC_DB_PORT=1433
MAUTIC_DB_NAME=sartorfit
MAUTIC_DB_USER=CloudSAf286aa7a@sartorfit-db  # Keep @server for Azure SQL
MAUTIC_DB_PASSWORD=SartorFit201
MAUTIC_DB_CHARSET=utf8mb4

# Connection Timeout & SSL Options (Mapped from JDBC)
MAUTIC_DB_OPTIONS='{"encrypt":true,"trustServerCertificate":false,"loginTimeout":30}'

# Table Mappings (Ensure these tables exist)
MAUTIC_DB_TABLE=[TOF-1]  # Use square brackets for SQL Server
MAUTIC_CONTACTS_TABLE=[TOF-1]  # Your main data table
